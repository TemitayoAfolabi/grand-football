# =============================================================================
# Grand Football — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Get these from: https://supabase.com/dashboard/project/<ref>/settings/api
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# Local: http://localhost:3000
# Production: https://grand-football.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------

# API-Football key. Keep server-side only: do not prefix with NEXT_PUBLIC_.
# Register at: https://dashboard.api-football.com/
API_FOOTBALL_API_KEY=

# Optional API-Football base URL. Normally leave this at the default below.
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# -----------------------------------------------------------------------------
# Cron Jobs
# -----------------------------------------------------------------------------

# Secret token to authenticate cron job requests
# Generate with: openssl rand -hex 32
CRON_SECRET=

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------

# Current Premier League season (e.g., 2025 for the 2025-2026 season)
# NOTE: Currently hardcoded in sync-fixtures route — update there too if changing
CURRENT_SEASON=2025

# Admin email (first user with this email gets is_admin = true)
ADMIN_EMAIL=
