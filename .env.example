# =============================================================================
# Grand Football — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Get these from: https://supabase.com/dashboard/project/<ref>/settings/api
# -----------------------------------------------------------------------------

# Supabase project URL (e.g., https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (SECRET — server-side only, never expose to client)
# Used by cron jobs and admin operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# Base URL of the app (used for OAuth redirect URLs)
# Local: http://localhost:3000
# Production: https://grand-football.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------

# football-data.org API key (free tier)
# Register at: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# football-data.org base URL
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# Premier League competition code
FOOTBALL_DATA_COMPETITION=PL

# -----------------------------------------------------------------------------
# Cron Jobs
# -----------------------------------------------------------------------------

# Secret token to authenticate cron job requests
# Generate with: openssl rand -hex 32
CRON_SECRET=

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------

# Current Premier League season (e.g., 2025 for the 2025-2026 season)
# NOTE: Currently hardcoded in sync-fixtures route — update there too if changing
CURRENT_SEASON=2025

# Admin email (first user with this email gets is_admin = true)
ADMIN_EMAIL=
